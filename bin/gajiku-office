#!/usr/bin/env python3
"""
gajiku-office — CLI Tool for Hermes Agent (Lisa) Integration with GAJIKU Office API

Allows Lisa (Hermes Agent PA) to query employees, payroll periods, and employee salary details
from Telegram or automated agent workflows without exposing tokens or mutating payroll data.

Usage:
  gajiku-office periods [--status <status>] [--json]
  gajiku-office employee <name_or_query> [--status <status>] [--json]
  gajiku-office salary --period <ID> --employee <ID> [--json]

Environment Variables:
  GAJIKU_API_URL   : Base URL for API v1 (default: http://127.0.0.1:18000/api/v1)
  GAJIKU_API_TOKEN : Bearer token for Lisa API client
"""

import sys
import os
import json
import argparse
import urllib.request
import urllib.error
import urllib.parse
from pathlib import Path


DEFAULT_API_URL = "http://127.0.0.1:18000/api/v1"


def get_api_token(custom_token: str = None) -> str:
    """
    Retrieve API token from argument, environment, or config file without logging or leaking.
    """
    if custom_token:
        return custom_token.strip()
    
    token = os.environ.get("GAJIKU_API_TOKEN")
    if token and token.strip():
        return token.strip()
    
    # Try reading from ~/.gajiku/token or /etc/gajiku/token
    user_token_file = Path.home() / ".gajiku" / "token"
    if user_token_file.exists():
        try:
            return user_token_file.read_text(encoding="utf-8").strip()
        except Exception:
            pass
            
    system_token_file = Path("/etc/gajiku/token")
    if system_token_file.exists():
        try:
            return system_token_file.read_text(encoding="utf-8").strip()
        except Exception:
            pass

    return ""


def get_base_url(custom_url: str = None) -> str:
    """
    Determine API Base URL.
    """
    if custom_url:
        return custom_url.rstrip("/")
    env_url = os.environ.get("GAJIKU_API_URL")
    if env_url and env_url.strip():
        return env_url.strip().rstrip("/")
    return DEFAULT_API_URL


def make_api_request(endpoint: str, params: dict = None, token: str = "", base_url: str = "") -> dict:
    """
    Execute HTTP GET request to GAJIKU API with sanitized error handling.
    Token is never included in exceptions or printed to stdout/stderr.
    """
    if not token:
        print("Error: Token API tidak ditemukan.", file=sys.stderr)
        print("Setel environment variable GAJIKU_API_TOKEN atau simpan token di ~/.gajiku/token", file=sys.stderr)
        sys.exit(1)

    url = f"{base_url}/{endpoint.lstrip('/')}"
    if params:
        query_string = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
        url = f"{url}?{query_string}"

    headers = {
        "Accept": "application/json",
        "Authorization": f"Bearer {token}",
        "User-Agent": "gajiku-office-cli/1.1 (Hermes Agent / Lisa PA)"
    }

    req = urllib.request.Request(url, headers=headers, method="GET")

    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = resp.read().decode("utf-8")
            return json.loads(data)
    except urllib.error.HTTPError as e:
        raw_error = e.read().decode("utf-8", errors="ignore")
        try:
            err_json = json.loads(raw_error)
            msg = err_json.get("message") or err_json.get("error") or f"HTTP {e.code}"
        except Exception:
            msg = f"HTTP {e.code}: {e.reason}"

        if e.code == 401:
            print("Error: Autentikasi API gagal (401 Unauthorized). Periksa token API.", file=sys.stderr)
        elif e.code == 403:
            print("Error: Akses ditolak (403 Forbidden). Token tidak memiliki scope yang diperlukan (misal: 'payroll:read').", file=sys.stderr)
        elif e.code == 404:
            print(f"Error (404 Not Found): {msg}", file=sys.stderr)
        elif e.code == 400:
            print(f"Error (400 Bad Request): {msg}", file=sys.stderr)
        else:
            print(f"Error ({e.code}): {msg}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Error Koneksi: Tidak dapat terhubung ke {base_url}. Pastikan reverse tunnel SSH aktif.", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: Terjadi kesalahan saat memproses permintaan API ({type(e).__name__}).", file=sys.stderr)
        sys.exit(1)


def format_rupiah(val: float) -> str:
    try:
        val_int = int(round(val))
        return f"Rp {val_int:,}".replace(",", ".")
    except Exception:
        return f"Rp {val}"


def cmd_periods(args, token: str, base_url: str):
    params = {}
    if args.status:
        params["status"] = args.status

    res = make_api_request("periods.php", params, token, base_url)

    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    periods = res.get("data", [])
    if not periods:
        print("Tidak ada periode payroll yang ditemukan.")
        return

    print("=== DAFTAR PERIODE PAYROLL ===")
    for p in periods:
        editable = "[Bisa Diajukan]" if p.get("is_editable") else "[Terkunci]"
        print(f"ID: {p['id']:<3} | {p['name']:<24} | Status: {p['status']:<7} {editable} | {p['start_date']} s/d {p['end_date']}")


def cmd_employee(args, token: str, base_url: str):
    params = {"q": args.query}
    if args.status:
        params["status"] = args.status

    res = make_api_request("employees.php", params, token, base_url)

    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    employees = res.get("data", [])
    if not employees:
        print(f"Tidak ada karyawan yang cocok dengan pencarian '{args.query}'.")
        return

    print(f"=== HASIL PENCARIAN KARYAWAN: '{args.query}' ===")
    for emp in employees:
        div = emp.get("division_name") or "-"
        pos = emp.get("position") or "-"
        print(f"ID: {emp['id']:<3} | NIK: {emp['nik']:<10} | {emp['full_name']:<25} | Jabatan: {pos} (Divisi: {div}) | Status: {emp['status']}")


def cmd_salary(args, token: str, base_url: str):
    if not args.period or int(args.period) <= 0:
        print("Error: Parameter --period wajib berupa ID bilangan bulat positif.", file=sys.stderr)
        sys.exit(1)
    if not args.employee or int(args.employee) <= 0:
        print("Error: Parameter --employee wajib berupa ID bilangan bulat positif.", file=sys.stderr)
        sys.exit(1)

    params = {
        "period_id": int(args.period),
        "employee_id": int(args.employee)
    }

    res = make_api_request("payroll_detail.php", params, token, base_url)

    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    data = res.get("data", {})
    emp_name = data.get("employee_name", "-")
    nik = data.get("nik", "-")
    pos = data.get("position", "-")
    div = data.get("division") or "-"
    per_name = data.get("period_name", "-")
    per_status = data.get("period_status", "-")
    basic = data.get("basic_salary", 0.0)
    bonus = data.get("total_bonus", 0.0)
    deduct = data.get("total_deductions", 0.0)
    thp = data.get("take_home_pay", 0.0)

    print("=== INFORMASI RINCIAN GAJI KARYAWAN ===")
    print(f"Nama Karyawan : {emp_name} (ID: {args.employee}, NIK: {nik})")
    print(f"Jabatan       : {pos} (Divisi: {div})")
    print(f"Periode       : {per_name} (ID: {args.period}, Status: {per_status})")
    print("-" * 52)
    print(f"Gaji Pokok    : {format_rupiah(basic)}")
    print(f"Total Bonus   : {format_rupiah(bonus)}")
    print(f"Total Potongan: {format_rupiah(deduct)}")
    print(f"Gaji Diterima : {format_rupiah(thp)} (Take Home Pay)")
    print("-" * 52)
    print("[Panduan untuk Lisa saat menjawab Bos]:")
    print("1. Sebutkan secara terpisah dan jelas:")
    print(f"   - Periode       : {per_name}")
    print(f"   - Gaji Pokok    : {format_rupiah(basic)}")
    print(f"   - Gaji Diterima : {format_rupiah(thp)} (Take Home Pay)")
    print("2. JANGAN mengklaim gaji pokok sama dengan gaji diterima jika terdapat bonus/potongan.")
    print("3. Jika Bos bertanya 'Berapa gaji sebulan?' tanpa menyebutkan periode, sebutkan periode yang dilaporkan secara eksplisit atau mintalah klarifikasi.")


def main():
    parser = argparse.ArgumentParser(
        prog="gajiku-office",
        description="Alat CLI Hermes Agent (Lisa) untuk integrasi dengan sistem GAJIKU Office."
    )
    parser.add_argument("--api-url", help="URL API GAJIKU v1 (default: $GAJIKU_API_URL atau http://127.0.0.1:18000/api/v1)")
    parser.add_argument("--token", help="Token API Lisa (disarankan menggunakan env GAJIKU_API_TOKEN)")

    subparsers = parser.add_subparsers(dest="subcommand", help="Perintah yang tersedia")

    # Command: periods
    p_periods = subparsers.add_parser("periods", help="Daftar periode payroll")
    p_periods.add_argument("--status", choices=["draft", "review", "final", "paid"], help="Filter status periode")
    p_periods.add_argument("--json", action="store_true", help="Keluarkan respons dalam format JSON mentah")

    # Command: employee
    p_emp = subparsers.add_parser("employee", help="Cari karyawan berdasarkan nama atau NIK")
    p_emp.add_argument("query", help="Nama karyawan atau NIK yang dicari")
    p_emp.add_argument("--status", default="active", help="Status karyawan (default: active)")
    p_emp.add_argument("--json", action="store_true", help="Keluarkan respons dalam format JSON mentah")

    # Command: salary
    p_sal = subparsers.add_parser("salary", help="Rincian gaji satu karyawan pada satu periode")
    p_sal.add_argument("--period", "-p", required=True, type=int, help="ID Periode Payroll")
    p_sal.add_argument("--employee", "-e", required=True, type=int, help="ID Karyawan")
    p_sal.add_argument("--json", action="store_true", help="Keluarkan respons dalam format JSON mentah")

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    token = get_api_token(args.token)
    base_url = get_base_url(args.api_url)

    if args.subcommand == "periods":
        cmd_periods(args, token, base_url)
    elif args.subcommand == "employee":
        cmd_employee(args, token, base_url)
    elif args.subcommand == "salary":
        cmd_salary(args, token, base_url)


if __name__ == "__main__":
    main()
